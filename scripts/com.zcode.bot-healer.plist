<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- The daemon's own dead-man's switch (scripts/bot-healer.nu).
         One shot per minute; the script's own rate limit (one action per
         5 min) is the second lock. No KeepAlive: the script exits. -->
    <key>Label</key>
    <string>com.zcode.bot-healer</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/Projects/zcode-bot-kotlin/scripts/bot-healer.nu</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__HOME__/.zcode/bot-kotlin/logs/healer.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.zcode/bot-kotlin/logs/healer.err.log</string>
</dict>
</plist>
