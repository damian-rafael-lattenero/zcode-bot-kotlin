<?xml version="1.0" encoding="UTF-8"?>
<!-- El autómata del cutover como job ONE-SHOT de launchd (lección medida: un
     nohup desde adentro del app muere con el árbol del app cuando launchd lo
     tumba; hijo de launchd, el autómata sobrevive a TODO).
     30/10: RunAtLoad era true — en CADA boot el cutover corria solo (--real:
     cierra el app, buildea, swap, reabre). El dueño lo vivio: reinicio la PC,
     abrio ZCode y el script arranco solo. DEPLOY = DECISION DEL DUEÑO, nunca
     un bootstrap. Carga manual cuando el la pide:
       launchctl kickstart gui/$(id -u)/com.zcode.deploy-fork
     Loguea a /tmp/deploy-fork.log, y al salir queda idle (inofensivo). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.zcode.deploy-fork</string>
  <key>ProgramArguments</key>
  <array>
    <!-- 2/11: launchd NO puede spawnear el binario nu-nightly directo
         (OS_REASON_CODESIGNING — ad-hoc linker-signed + xattr provenance;
         desde shell anda, desde launchd no). El wrapper zsh (firmado por
         Apple) lo exec como hijo y pasa el gate. -->
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>exec /Users/lattenero/.local/bin/nu-nightly /Users/lattenero/Projects/zcode-bot-kotlin/scripts/deploy-fork-and-retire.nu --real</string>
  </array>
  <key>StandardOutPath</key><string>/tmp/deploy-fork.log</string>
  <key>StandardErrorPath</key><string>/tmp/deploy-fork.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
