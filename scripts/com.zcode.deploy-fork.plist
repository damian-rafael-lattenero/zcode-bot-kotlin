<?xml version="1.0" encoding="UTF-8"?>
<!-- The cutover automaton as a launchd ONE-SHOT job (measured lesson: a
     nohup from inside the app dies with the app tree when launchd
     takes it down; a launchd child, the automaton survives EVERYTHING).
     10/30: RunAtLoad was true — on EVERY boot the cutover ran on its own (--real:
     closes the app, builds, swaps, reopens). The owner lived it: he restarted the PC,
     opened ZCode and the script started on its own. DEPLOY = THE OWNER DECISION, never
     a bootstrap. Loaded by hand when he asks:
       launchctl kickstart gui/$(id -u)/com.zcode.deploy-fork
     Logs to /tmp/deploy-fork.log, and goes idle on exit (harmless). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.zcode.deploy-fork</string>
  <key>ProgramArguments</key>
  <array>
    <!-- 2/11: launchd NO puede spawnear el binario nu-nightly directo
         (OS_REASON_CODESIGNING — ad-hoc linker-signed + xattr provenance;
         from a shell it works, from launchd it does not). The zsh wrapper (signed by
         Apple) execs it as a child and passes the gate. -->
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>exec /Users/lattenero/.local/bin/nu-nightly /Users/lattenero/Projects/zcode-bot-kotlin/scripts/deploy-fork-and-retire.nu --real</string>
  </array>
  <key>StandardOutPath</key><string>/tmp/deploy-fork.log</string>
  <key>StandardErrorPath</key><string>/tmp/deploy-fork.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
