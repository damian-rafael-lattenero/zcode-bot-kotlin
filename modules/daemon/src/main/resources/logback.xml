<?xml version="1.0" encoding="UTF-8"?>
<!--
  E1 (parity-and-engineering.md §3): JSONL append-only logs with MDC, async
  and never-blocking — the observability-never-breaks-a-turn law, the same
  one the Python bus tap follows. LOG_DIR is injected by the LaunchAgent;
  tests inherit the default. Size+time rolling with a total cap: the
  294 MB errors.log lesson becomes a policy.
-->
<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-${user.home}/.zcode/bot-kotlin/logs}"/>

    <appender name="JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/daemon.jsonl</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/daemon-%d{yyyy-MM-dd}.%i.jsonl</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>400MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"zcode-bot-daemon"}</customFields>
        </encoder>
    </appender>

    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <!-- the queue may drop on overflow, but it may never block a cycle -->
        <neverBlock>true</neverBlock>
        <appender-ref ref="JSON"/>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z', UTC} %-5level %logger{24} [%X{component}] %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="ASYNC"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
