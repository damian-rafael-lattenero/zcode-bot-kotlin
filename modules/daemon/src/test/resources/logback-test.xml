<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tests must never touch the production log tree: console only, no file
  appenders (the main logback.xml defaults to ~/.zcode/bot-kotlin/logs).
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} [%X{component}] %msg%n</pattern>
        </encoder>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
